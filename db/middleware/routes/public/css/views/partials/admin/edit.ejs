<!DOCTYPE html>
<html lang="en">
<head>
  <title>edit script — Corex Staff Only</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/topbar') %>

  <div class="shell">
    <div class="admin-topbar">
      <div class="admin-title">Edit script</div>
      <div class="admin-actions">
        <a href="/admin" class="btn btn-outline">&larr; back to dashboard</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="error-banner"><%= error %></div>
    <% } %>

    <form action="/admin/edit/<%= script.id %>" method="post" style="max-width: 720px; padding-bottom: 80px;">
      <div class="field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= script.title %>" required autofocus>
      </div>

      <div class="form-row-2">
        <div class="field">
          <label for="game">Game (optional)</label>
          <input type="text" id="game" name="game" value="<%= script.game || '' %>">
        </div>
        <div class="field">
          <label for="language">Language</label>
          <select id="language" name="language">
            <% ['lua','luau','javascript','python','text'].forEach(function(l) { %>
              <option value="<%= l %>" <%= script.language === l ? 'selected' : '' %>><%= l %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="description">Description (optional)</label>
        <input type="text" id="description" name="description" value="<%= script.description || '' %>">
      </div>

      <div class="field">
        <label for="youtube_url">YouTube URL (optional)</label>
        <input type="url" id="youtube_url" name="youtube_url" value="<%= script.youtube_url || '' %>" placeholder="https://www.youtube.com/watch?v=...">
        <div class="field-hint">Paste a YouTube link and its thumbnail is automatically used as the script's preview image. Clear this field to remove the thumbnail.</div>
      </div>

      <div class="field">
        <label for="thumbnail_override">Custom thumbnail URL (optional)</label>
        <input type="url" id="thumbnail_override" name="thumbnail_override" placeholder="overrides the YouTube thumbnail if set">
      </div>

      <div class="field">
        <label for="content">Script content</label>
        <textarea id="content" name="content" class="code-input" required><%= script.content %></textarea>
      </div>

      <button type="submit" class="btn btn-primary">save changes</button>
    </form>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
