<!DOCTYPE html>
<html lang="en">
<head>
  <title>upload script — Corex Staff Only</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/topbar') %>

  <div class="shell">
    <div class="admin-topbar">
      <div class="admin-title">Upload script</div>
      <div class="admin-actions">
        <a href="/admin" class="btn btn-outline">&larr; back to dashboard</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="error-banner"><%= error %></div>
    <% } %>

    <form action="/admin/upload" method="post" style="max-width: 720px; padding-bottom: 80px;">
      <div class="field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. Infinite Yield" required autofocus>
      </div>

      <div class="form-row-2">
        <div class="field">
          <label for="game">Game (optional)</label>
          <input type="text" id="game" name="game" placeholder="e.g. Blox Fruits">
        </div>
        <div class="field">
          <label for="language">Language</label>
          <select id="language" name="language">
            <option value="lua" selected>Lua</option>
            <option value="luau">Luau</option>
            <option value="javascript">JavaScript</option>
            <option value="python">Python</option>
            <option value="text">Plain text</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="description">Description (optional)</label>
        <input type="text" id="description" name="description" placeholder="short summary of what it does">
      </div>

      <div class="field">
        <label for="youtube_url">YouTube URL (optional)</label>
        <input type="url" id="youtube_url" name="youtube_url" placeholder="https://www.youtube.com/watch?v=...">
        <div class="field-hint">Paste a YouTube link and its thumbnail is automatically used as the script's preview image. The video will also be embedded on the script page.</div>
      </div>

      <div class="field">
        <label for="thumbnail_override">Custom thumbnail URL (optional)</label>
        <input type="url" id="thumbnail_override" name="thumbnail_override" placeholder="overrides the YouTube thumbnail if set">
      </div>

      <div class="field">
        <label for="content">Script content</label>
        <textarea id="content" name="content" class="code-input" placeholder="paste your script here..." required></textarea>
      </div>

      <button type="submit" class="btn btn-primary">upload script</button>
    </form>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
