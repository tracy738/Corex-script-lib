# Copy this file to .env for local development.
# On Render, set these under your service's Environment tab instead —
# do not upload a real .env file to GitHub.

# Login credentials for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Random long string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Leave unset for local dev. On Render with a persistent disk, set to
# the disk's mount path, e.g. /var/data/scripts.db
# DB_PATH=/var/data/scripts.db

NODE_ENV=production
PORT=3000
